# ============================================================
# Salvage Pulse AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values. Never commit .env.

# ------------------------------------------------------------
# Runtime / security
# ------------------------------------------------------------
# production enables HSTS, disables API docs, and tightens cookies.
ENVIRONMENT=production

# Public URL used in emails and redirects (no trailing slash).
APP_URL=https://app.salvagepulsepro.com

# Comma-separated Host-header allowlist (also used for generated links when
# APP_URL is blank). Set this in production to block DNS-rebinding/CSRF tricks.
# Loopback hosts are always accepted for health checks.
# ALLOWED_HOSTS=app.salvagepulsepro.com

# Set to 1 when served over HTTPS. Set to 0 only for plain-HTTP LAN use.
COOKIE_SECURE=1

# Interface and port the systemd service binds to. Use 127.0.0.1 when a
# reverse proxy (Caddy/nginx) terminates TLS on the same host.
APP_BIND_HOST=0.0.0.0
PORT=8000

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For / Proto.
TRUST_PROXY_HEADERS=0

# Where JSON state, uploads, the SQLite DB and the bootstrap password live.
# Docker default: /app/backend/data
# Proxmox default: /opt/salvage-pulse/backend/data
# DATA_DIR=/app/backend/data

# Demo seeding and one-click demo logins are OFF by default.
# Turn these on only for a disposable demo instance.
SEED_DEMO_DATA=0
DEMO_LOGIN_ENABLED=0

# Initial platform-master accounts. INITIAL_MASTER_EMAILS is authoritative and
# accepts a comma-separated list. Names are optional; known platform addresses
# get friendly defaults. New masters are added to existing state once and must
# change their password at first sign-in.
INITIAL_MASTER_EMAILS=brettk@salvagepulsepro.com,benk@salvagepulsepro.com,genk@salvagepulsepro.com
INITIAL_MASTER_NAMES="Brett K,Ben K,Gen K"

# Legacy single-master settings. INITIAL_MASTER_EMAILS takes precedence; these
# remain useful for custom single-account installs.
INITIAL_MASTER_EMAIL=brettk@salvagepulsepro.com
INITIAL_MASTER_NAME="Brett K"

# Optional password for the first configured master only. Leave blank to have a
# unique random password per master written to
# $DATA_DIR/initial_admin_password.txt on first boot.
INITIAL_MASTER_PASSWORD=

# Login/signup rate limits (attempts per window, in seconds).
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=3600

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=25

# ------------------------------------------------------------
# AI / Google
# ------------------------------------------------------------
# Google Gemini API key for real AI scoring and roleplay.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 Client ID (Sign in with Google). Tokens are verified
# server-side against this audience; blank disables Google sign-in.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------
# Provider-agnostic call ingestion / speech-to-text
# ------------------------------------------------------------
# Gemini is the default when configured because it transcribes and scores in
# one pass. You only need one of these providers. A webhook that already sends
# a transcript needs none of them.
# INGEST_STT_PROVIDER=auto          # auto | gemini | deepgram | assemblyai | openai
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
# Optional: lets the Telnyx adapter download recordings that require auth.
TELNYX_API_KEY=

# Recordings pushed by a phone system can be larger than manual uploads.
MAX_INGEST_MB=100
INGEST_MEDIA_MAX_MB=100
# Set to 1 only if recordings live on a trusted private/LAN host (e.g. a
# self-hosted PBX). Leave 0 in production to prevent SSRF.
INGEST_ALLOW_PRIVATE_MEDIA_HOSTS=0

# ------------------------------------------------------------
# Outbound email (Gmail SMTP or any SMTP relay)
# ------------------------------------------------------------
SUPPORT_EMAIL=support@salvagepulsepro.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Salvage Pulse"
SMTP_FROM=
