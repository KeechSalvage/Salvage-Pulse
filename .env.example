# ============================================================
# Salvage Pulse AI - Environment Configuration
# ============================================================

# Google Gemini API Key for Real AI Call Scoring & Roleplay
# 1. Get a 100% free API key from Google AI Studio: https://aistudio.google.com/
# 2. Paste your key below:
GEMINI_API_KEY=

# Model to use for analysis (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional Server Port (default: 8000)
PORT=8000
