# ============================================================
# Salvage Pulse AI - Environment Configuration
# ============================================================

# Google Gemini API Key for Real AI Call Scoring & Roleplay
# 1. Get a 100% free API key from Google AI Studio: https://aistudio.google.com/
# 2. Paste your key below:
GEMINI_API_KEY=

# Model to use for analysis (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth 2.0 Client ID (Sign in with Google)
# 1. Create an OAuth 2.0 Client ID (Web Application) in Google Cloud Console
# 2. Add your authorized JavaScript origins (e.g. http://localhost:8000, http://10.1.11.76:8000)
# 3. Paste the client ID below. If left blank, Salvage Pulse uses an interactive account chooser.
GOOGLE_CLIENT_ID=

# Optional Server Port (default: 8000)
PORT=8000
