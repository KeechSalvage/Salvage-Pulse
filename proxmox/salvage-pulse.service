[Unit]
Description=Salvage Pulse AI - Auto Recycler Call Intelligence & CRM
After=network.target

[Service]
Type=simple
User=salvage-pulse
Group=salvage-pulse
WorkingDirectory=/opt/salvage-pulse/backend
EnvironmentFile=-/opt/salvage-pulse/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/salvage-pulse/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Sandboxing & security hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/opt/salvage-pulse/backend/data /opt/salvage-pulse/backend/uploads

[Install]
WantedBy=multi-user.target
