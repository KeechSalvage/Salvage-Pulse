# ============================================================
# Salvage Pulse AI - Backend Environment Configuration
# ============================================================
# Copy to backend/.env for local development. Never commit real secrets.

ENVIRONMENT=development
APP_URL=http://localhost:8000
# ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=0
TRUST_PROXY_HEADERS=0
SEED_DEMO_DATA=0
DEMO_LOGIN_ENABLED=0

INITIAL_MASTER_EMAIL=brettk@salvagepulsepro.com
INITIAL_MASTER_NAME=Brett K
INITIAL_MASTER_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=

# Provider-agnostic call ingestion. Only one STT provider is needed; a webhook
# that sends a finished transcript needs none of them.
INGEST_STT_PROVIDER=auto
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
TELNYX_API_KEY=
MAX_INGEST_MB=100
INGEST_MEDIA_MAX_MB=100
INGEST_ALLOW_PRIVATE_MEDIA_HOSTS=0

SUPPORT_EMAIL=support@salvagepulsepro.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Salvage Pulse"
SMTP_FROM=

PORT=8000
